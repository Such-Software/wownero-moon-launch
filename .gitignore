# Godot 4 - generated files
.godot/
.import/

# Godot uid files (auto-generated)
*.uid

# Mono/C#
.mono/
data_*/
mono_crash.*.json

# Export builds
builds/
*.aab
*.apk
*.apk.idsig
*.ipa
*.dmg
*.exe
*.x86_64
*.pck

# Android build artifacts
android/build/
android/.build_version

# OS/editor junk
**/.DS_Store
**/Thumbs.db
*.swp
*~
.vscode/

# Screenshots (optional - remove this line if you want them tracked)
# screenshots/
*.tmp
.syncthing*

# GdUnit4 test reports
reports/

# Ad setup guide (untracked, contains placeholder instructions)
ADS.md

# Deploy guide (untracked, contains signing/release instructions)
DEPLOY.md

# Capture sheet (untracked, contains production IDs / OAuth client IDs)
CAPTURE.md

# Signing material copied locally for headless builds (sandbox workaround)
.signing/

# AdMob downloaded native libraries (large binaries, per-machine)
addons/admob/downloads/
addons/admob/android/bin/
# AdMob iOS plugin (downloaded via the AdMob editor menu — per-machine).
# We ignore everything under ios/plugins/ EXCEPT the godot-storekit2 plugin
# we ship as a versioned release artifact (~2 MB).
ios/plugins/*
!ios/plugins/godot-storekit2.gdip
!ios/plugins/godot-storekit2.debug.xcframework
!ios/plugins/godot-storekit2.release.xcframework

# Google iOS SDK frameworks (downloaded per-machine; 37MB GoogleMobileAds + UMP)
ios/framework/

# Firebase client config (contains client API keys; unused until the Firebase
# SDK is integrated in v1.1.0). Kept locally, out of version control.
android/google-services.json
ios/GoogleService-Info.plist

# marketing renders + heavy source assets
marketing/out/
marketing/**/.assemble_tmp/
marketing/assets/characters/*.glb
marketing/assets/music/*
marketing/assets/vo/*

# RL training artifacts
rl/.venv/
rl/*.onnx
rl/train_logs/
rl/logs/
rl/checkpoints/
rl/*.zip

# transient capture window-mode override (marketing/lib/capture.sh)
override.cfg

# rendered video outputs (regenerable via render_level.sh / render_remote.sh)
out/

# agent memory / session state (not part of the game)
.claude/

# RL dev artifacts (exported policy source + test cases; shipped copy is game/ai/)
rl/*.json

# Firebase config bundled by the iOS plugin (API keys)
ios/plugins/GoogleService-Info.plist
