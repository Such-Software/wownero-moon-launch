; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Such Moon Launch"
config/version="1.3.0"
run/main_scene="res://game/gui/menu/Menu.tscn"
config/features=PackedStringArray("4.6")
boot_splash/bg_color=Color(0.05, 0.05, 0.1, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://art/branding/circuit_dark_w_text.png"
config/icon="res://art/branding/icon.png"

[autoload]

Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
globalvar="*res://globalvar.gd"
HintService="*res://game/HintService.gd"
HazardHints="*res://game/HazardHints.gd"
ScoreClient="*res://game/net/ScoreClient.gd"
CloudSave="*res://game/net/CloudSave.gd"
AdManager="*res://game/net/AdManager.gd"
GodotPlayGameServices="*res://addons/GodotPlayGameServices/scripts/autoloads/godot_play_game_services.gd"
PlayGamesManager="*res://game/net/PlayGamesManager.gd"
GameCenterManager="*res://game/net/GameCenterManager.gd"
ShareService="*res://game/net/ShareService.gd"
IAPManager="*res://game/net/IAPManager.gd"
Telemetry="*res://game/net/Telemetry.gd"
Analytics="*res://game/net/Analytics.gd"
WarpTransition="*res://game/warp/WarpTransition.gd"
AutoPilot="*res://game/test/AutoPilot.gd"
RaceController="*res://game/race/RaceController.gd"
SimHarness="*res://game/test/SimHarness.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=600
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[dotnet]

project/assembly_name="Such Moon Launch"

[editor_plugins]

enabled=PackedStringArray("res://addons/AdmobPlugin/plugin.cfg", "res://addons/BloomwordFirebase/plugin.cfg", "res://addons/GodotPlayGameServices/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg")

[input]

; Gamepad bindings (WP-A4). Keyboard events are preserved; joypad events are
; added alongside (both stay live). ui_left/ui_right keep Godot's joypad
; defaults for rotate. Button map (Xbox layout):
;   thrust     = Ⓐ (JOY_BUTTON_A=0)         + right trigger (JOY_AXIS_TRIGGER_RIGHT=5)
;   revthrust  = Ⓑ (JOY_BUTTON_B=1)         + left trigger  (JOY_AXIS_TRIGGER_LEFT=4)
;   fire       = Ⓧ (JOY_BUTTON_X=2)
;   missile    = Ⓨ (JOY_BUTTON_Y=3)
;   laser      = LB (JOY_BUTTON_LEFT_SHOULDER=9)
;   emp        = RB (JOY_BUTTON_RIGHT_SHOULDER=10)

thrust={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
, Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":5,"axis_value":1.0,"script":null)
]
}
